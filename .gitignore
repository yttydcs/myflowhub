# Root gitignore for the MyFlowHub3 workspace

# Local SDK / large vendor-like directories (should not be committed)
/_android-sdk/

# Temp / scratch outputs
/_tmp/
/.tmp/

# Local agent/dev tooling
/.claude/

# Local multi-checkout worktrees (ephemeral)
/worktrees/
/repo/
/repo/worktrees/

# Go build artifacts
*.exe
*.dll
*.so
*.dylib
*.test
*.out
*.a
*.o
*.obj

# Go tooling output
coverage*.out
*.prof
*.pprof

# Common build/output folders (workspace-level)
/bin/
/dist/
/build/*
/out/
**/build/
!/build/
!/build/toolchain.json
!/apps/desktop/build/
/apps/desktop/build/*
!/apps/desktop/build/appicon.png
!/apps/desktop/build/windows/
/apps/desktop/build/windows/*
!/apps/desktop/build/windows/icon.ico
**/.gradle/
**/node_modules/
**/local.properties
**/__pycache__/
managed_components/
dependencies.lock

# Android build outputs (workspace-level)
*.apk
*.aab
*.aar

# Logs
*.log

# Local env files
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.ace-tool/
